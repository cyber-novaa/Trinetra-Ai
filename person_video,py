"""Run person detection on a local video and save the annotated result."""

from __future__ import annotations

import argparse
from pathlib import Path

import cv2
from ultralytics import YOLO

from detector import annotate_frame


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("video", type=Path, help="Input video file, for example input_video.mp4")
    parser.add_argument("--output", type=Path, help="Output MP4 path (default: <input>_detected.mp4)")
    parser.add_argument("--model", type=Path, default=Path(__file__).resolve().parent / "yolov8n.pt", help="YOLO weights file")
    parser.add_argument("--confidence", type=float, default=0.50, help="Detection threshold from 0 to 1 (default: 0.50)")
    parser.add_argument("--no-preview", action="store_true", help="Process without opening a preview window")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not 0.0 <= args.confidence <= 1.0:
        raise SystemExit("--confidence must be between 0 and 1")
    if not args.video.is_file():
        raise SystemExit(f"Input video does not exist: {args.video}")
    if not args.model.is_file():
        raise SystemExit(f"Model weights do not exist: {args.model}")

    output_path = args.output or args.video.with_name(f"{args.video.stem}_detected.mp4")
    capture = cv2.VideoCapture(str(args.video))
    if not capture.isOpened():
        raise SystemExit(f"OpenCV could not open the video: {args.video}")
    width = int(capture.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(capture.get(cv2.CAP_PROP_FRAME_HEIGHT))
    fps = capture.get(cv2.CAP_PROP_FPS)
    if width <= 0 or height <= 0:
        capture.release()
        raise SystemExit("The video has invalid frame dimensions.")
    if fps <= 0:
        fps = 25.0

    output_path.parent.mkdir(parents=True, exist_ok=True)
    writer = cv2.VideoWriter(str(output_path), cv2.VideoWriter_fourcc(*"mp4v"), fps, (width, height))
    if not writer.isOpened():
        capture.release()
        raise SystemExit(f"Could not create output video: {output_path}")
    model = YOLO(str(args.model))
    frames = 0
    try:
        while True:
            ok, frame = capture.read()
            if not ok:
                break
            annotated, _ = annotate_frame(frame, model, args.confidence)
            writer.write(annotated)
            frames += 1
            if not args.no_preview:
                cv2.imshow("Trinetra Person Detection · press q to stop preview", annotated)
                if cv2.waitKey(1) & 0xFF == ord("q"):
                    break
    finally:
        capture.release()
        writer.release()
        if not args.no_preview:
            cv2.destroyAllWindows()
    print(f"Processed {frames} frames. Saved: {output_path.resolve()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
